# Bedrock Knowledge Base
KB_ID=ABCDEG  # Knowledge Base ID (not ARN) — found in Bedrock console under Knowledge Bases

# AWS
AWS_REGION=us-east-1

# Option 1: use a named profile from ~/.aws/credentials
#AWS_PROFILE=default

# Option 2: explicit credentials (leave blank if using AWS_PROFILE)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=  # only needed for temporary/assumed-role credentials

# Arize Phoenix Cloud (Phase 3)
PHOENIX_API_KEY=<from Phoenix Settings → API Keys>
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/s/<your-workspace-slug>
PHOENIX_PROJECT=crdc-eval   # optional — defaults to "crdc-eval" if not set
